# Variáveis do site. Aqui ficam só os nomes: os valores vão no .env.local (ignorado pelo Git) no computador e, na nuvem,
# nas variáveis de cada contexto da Netlify. O build de produção (npm run build) confere todas em src/lib/env.ts e para
# dizendo qual falta. Obrigatórias: todas, menos SMTP_USER e SMTP_PASS (as duas juntas ou nenhuma) e as opcionais do fim.

# --- Públicas (prefixo NEXT_PUBLIC_, vão para o navegador; não são segredo) ---
# Endereço do projeto Supabase (staging no branch deploy, prod em produção). Fica na Netlify e no .env.local.
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública do Supabase (anon ou publishable); a RLS protege os dados. Fica na Netlify e no .env.local.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Endereço base do site para os links dos convites e do aceite (http://localhost:3000 no computador). Fica na Netlify.
NEXT_PUBLIC_SITE_URL=
# Captcha (Cloudflare Turnstile) do login, de Criar conta, de Esqueci minha senha e do convite. Desligado nesta versão:
# deixe vazia ou false. Só true liga, e aí NEXT_PUBLIC_TURNSTILE_SITE_KEY passa a ser obrigatória e o captcha precisa
# estar ligado também no Supabase (guias/deploy.md).
NEXT_PUBLIC_CAPTCHA_LIGADO=
# Site key do widget do Turnstile, só exigida com o captcha ligado. No computador, a chave de teste
# 1x00000000000000000000AA, que sempre aprova; na nuvem, a do widget criado na Cloudflare. A chave secreta do Turnstile
# não entra aqui nem na Netlify: fica só no painel do Supabase (Authentication → Attack Protection) de cada projeto.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- De servidor (segredo ou dado do servidor; nunca com NEXT_PUBLIC_, só lidas em código server-only) ---
# Chave admin do Supabase (service_role ou secret), que ignora a RLS. Na Netlify marcada como secreta, e no .env.local.
SUPABASE_SERVICE_ROLE_KEY=
# SMTP do convite e do aviso de pedido de acesso. Na nuvem, o Resend (smtp.resend.com, 465, usuário resend e a chave da
# API como senha), na Netlify. No computador, o Mailpit do Supabase local: SMTP_HOST=127.0.0.1 e SMTP_PORT=54325, sem
# usuário e senha.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Remetente dos e-mails, como "Escola de Música <avisos@dominio>".
SMTP_REMETENTE=
# E-mail do professor, que recebe o aviso de pedido de acesso novo.
EMAIL_PROFESSOR=

# --- Opcionais ---
# Sentry (erros do servidor, sem dados pessoais; ver guias/deploy.md): o DSN do projeto e o nome do ambiente
# (homologacao ou producao). Ficam na Netlify. Sem o DSN, nenhum erro é enviado.
SENTRY_DSN=
SENTRY_AMBIENTE=

# --- Só para a CLI do Supabase (npm run db:push:staging e db:push:prod), fora da conferência do build ---
# Identificador (Project ID) dos projetos ava-staging e ava-prod. Não é segredo. Fica no .env.local e nas variáveis do
# GitHub Actions; a senha do banco a CLI pede no terminal, e no CI ela é segredo do GitHub Actions.
STAGING_PROJECT_REF=
PROD_PROJECT_REF=
