# Variáveis do site. O build de produção (npm run build) confere todas em src/env.ts e para dizendo qual falta.
# Obrigatórias: todas, menos SMTP_USER e SMTP_PASS (que vêm juntas ou nenhuma das duas).
# Supabase: endereço do projeto e chave pública (anon); a service_role só no servidor, nunca com NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Endereço do site, usado nos links dos convites e do aceite (http://localhost:3000 no computador).
NEXT_PUBLIC_SITE_URL=
# Chave do site do Cloudflare Turnstile (captcha do login, de Criar conta e do convite). No computador, a chave de teste
# 1x00000000000000000000AA, que sempre aprova; na nuvem, a do widget criado na Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Convite do aluno e aviso de pedido de acesso ao professor (Resend na nuvem: smtp.resend.com, 465, resend, chave da API).
# No computador, o Mailpit do Supabase local: SMTP_HOST=127.0.0.1 e SMTP_PORT=54325, sem usuário e senha.
# Obrigatórias: SMTP_HOST, SMTP_PORT, SMTP_REMETENTE e EMAIL_PROFESSOR (e-mail que recebe o aviso de pedido novo).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_REMETENTE=
EMAIL_PROFESSOR=
# Opcionais. Sentry (erros do servidor, sem dados pessoais; ver guias/deploy.md): o DSN do projeto no Sentry e o nome do
# ambiente (homologacao ou producao). Sem o DSN, nenhum erro é enviado.
SENTRY_DSN=
SENTRY_AMBIENTE=
# Só para a CLI do Supabase (npm run db:push:staging e db:push:prod; ver guias/deploy.md), fora da conferência do build:
# o identificador (Project ID) dos projetos ava-staging e ava-prod. Não é segredo; a senha do banco a CLI pede no terminal.
STAGING_PROJECT_REF=
PROD_PROJECT_REF=
